{
  "installCommand": "bun install",
  "buildCommand": "bun scripts/vercel-build.ts",
  "outputDirectory": "public",
  "rewrites": [{ "source": "/embed", "destination": "/index.html" }],
  "headers": [
    { "source": "/(.*)", "headers": [{ "key": "Referrer-Policy", "value": "no-referrer" }, { "key": "X-Content-Type-Options", "value": "nosniff" }] },
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/manifest.webmanifest", "headers": [{ "key": "Content-Type", "value": "application/manifest+json" }] },
    { "source": "/font-tools/subset.wasm", "headers": [{ "key": "Content-Type", "value": "application/wasm" }] }
  ]
}
