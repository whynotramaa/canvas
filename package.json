{
  "name": "canvas-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --hot apps/web/server.ts",
    "build": "NODE_ENV=production bun build --minify --splitting --target=bun apps/web/server.ts --outdir dist",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "start": "cd dist && NODE_ENV=production bun server.js",
    "smoke": "bun run build && bun scripts/smoke.ts",
    "icons:build": "bun packages/icons/build.ts",
    "fonts:build": "bun packages/fonts/build.ts && bun packages/fonts/build-tools.ts"
  },
  "dependencies": {
    "@fontsource/architects-daughter": "^5.3.0",
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/gaegu": "^5.3.0",
    "@fontsource/geist": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/gochi-hand": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/kalam": "^5.3.0",
    "@fontsource/lilita-one": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/noto-color-emoji": "^5.3.2",
    "@fontsource/noto-sans-arabic": "^5.3.0",
    "@fontsource/noto-sans-devanagari": "^5.3.0",
    "@fontsource/noto-sans-jp": "^5.3.1",
    "@fontsource/noto-sans-kr": "^5.3.1",
    "@fontsource/noto-sans-sc": "^5.3.1",
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/patrick-hand": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.1",
    "@fontsource/space-mono": "^5.3.0",
    "elkjs": "0.10.0",
    "fflate": "^0.8.3",
    "harfbuzzjs": "^1.6.4",
    "katex": "0.16.22",
    "lucide-react": "^1.66.0",
    "pdf-lib": "^1.17.1",
    "perfect-freehand": "^1.2.3",
    "points-on-path": "^0.2.1",
    "rbush": "^4.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "roughjs": "^4.6.6",
    "svgpath": "^2.6.0",
    "wawoff2": "^2.0.1",
    "yjs": "^13.6.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/katex": "^0.16.8",
    "@types/rbush": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "fake-indexeddb": "^6.2.7",
    "simple-icons": "^16.36.0",
    "typescript": "^5.0.0"
  }
}
